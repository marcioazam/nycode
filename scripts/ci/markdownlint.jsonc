{
  // Permissive on purpose: long lines, tables and inline HTML are normal in these docs.
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD032": false,
    "MD033": false,
    "MD036": false,
    "MD041": false,
    "MD060": false
  },
  // Upstream changelogs keep upstream formatting (rewriting them would conflict on every sync, 08); nycode entries
  // go under [Unreleased] as AGENTS.md says.
  // packages/coding-agent/src/extensions/_shared/builtin-styles/: output-style prompts sent to the model as written;
  // a lint fix would change the prompt (parity, 00).
  // packages/coding-agent/resources/skills/ponytail*/: skills of the pinned ponytail fork, byte for byte (D-54); a lint
  // fix would break that identity and change the prompt.
  "ignores": [
    "packages/*/CHANGELOG.md",
    "packages/coding-agent/src/extensions/_shared/builtin-styles/*.md",
    "packages/coding-agent/resources/skills/ponytail*/SKILL.md"
  ],
  "gitignore": false,
  "noProgress": true
}
