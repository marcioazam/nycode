# Default to LF for text files across the repo
* text=auto eol=lf

# Windows scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell scripts should keep LF
*.sh text eol=lf

# Archived patch artifacts preserve whitespace exactly
packages/agent/docs/**/*.diff -whitespace

# Common binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.tgz binary

# Product binaries. The git object is the LFS pointer; checkout smudges the file.
apps/p2/plugins/terminals/vendor/ghostty/ghostty-vt.wasm filter=lfs diff=lfs merge=lfs -text
packages/coding-agent/examples/extensions/doom-overlay/doom/build/doom.wasm filter=lfs diff=lfs merge=lfs -text
packages/tui/native/darwin/prebuilds/darwin-arm64/darwin-platform.node filter=lfs diff=lfs merge=lfs -text
packages/tui/native/darwin/prebuilds/darwin-x64/darwin-platform.node filter=lfs diff=lfs merge=lfs -text
packages/tui/native/linux/prebuilds/linux-arm64/linux-platform-x11.node filter=lfs diff=lfs merge=lfs -text
packages/tui/native/linux/prebuilds/linux-x64/linux-platform-x11.node filter=lfs diff=lfs merge=lfs -text
packages/tui/native/win32/prebuilds/win32-arm64/win32-platform.node filter=lfs diff=lfs merge=lfs -text
packages/tui/native/win32/prebuilds/win32-x64/win32-platform.node filter=lfs diff=lfs merge=lfs -text
