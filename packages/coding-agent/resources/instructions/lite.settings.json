{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run|Edit|Write|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${NYCODE_RESOURCES}/hooks/guard.py",
            "onFailure": "block",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
